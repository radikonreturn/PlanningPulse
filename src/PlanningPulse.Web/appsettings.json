{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "PlanningPulse": "Data Source=planningpulse.db"
  },
  "Jwt": {
    "Issuer": "PlanningPulse",
    "Audience": "PlanningPulse",
    "SigningKey": "replace-this-development-key-with-a-secret-of-at-least-32-bytes",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
