@page "/inventory"
@layout MainLayout
@using Microsoft.EntityFrameworkCore
@using PlanningPulse.Domain.Inventory
@inject AppState AppState
@inject PlanningPulse.Infrastructure.Persistence.PlanningPulseDbContext DbContext
@inject PlanningPulse.Application.Tenancy.ITenantSetter TenantSetter
@implements IDisposable

<div class="card fade-up">
    <div class="card-header">
        <div class="card-title">Inventory Levels</div>
        <span class="badge badge-info">@inventory.Count records</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Item Number</th>
                    <th>Name</th>
                    <th>Location</th>
                    <th>On Hand</th>
                    <th>Allocated</th>
                    <th>On Order</th>
                    <th>Safety Stock</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (inventory.Count == 0)
                {
                    <tr>
                        <td colspan="8" style="text-align:center;color:var(--text3);padding:20px;">No inventory levels found in database.</td>
                    </tr>
                }
                @foreach (var inv in inventory)
                {
                    var status = GetInventoryStatus(inv.OnHandQuantity, inv.Item.SafetyStockQuantity);
                    var statusClass = status == "Critical" ? "badge-danger" : status == "Low" ? "badge-warn" : "badge-success";
                    
                    <tr>
                        <td><strong>@inv.Item.ItemNumber</strong></td>
                        <td>@inv.Item.Name</td>
                        <td><span style="font-family:monospace; font-weight:600; color:var(--text2)">@inv.LocationCode</span></td>
                        <td><strong>@inv.OnHandQuantity.ToString("G29")</strong></td>
                        <td>@inv.AllocatedQuantity.ToString("G29")</td>
                        <td>@inv.OnOrderQuantity.ToString("G29")</td>
                        <td>@inv.Item.SafetyStockQuantity.ToString("G29")</td>
                        <td>
                            <span class="badge @statusClass">@status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<InventoryLevel> inventory = new();

    protected override async Task OnInitializedAsync()
    {
        AppState.PageTitle = "Inventory";
        AppState.OnChange += StateHasChanged;

        TenantSetter.SetTenant(AppState.TenantId);
        inventory = await DbContext.InventoryLevels
            .Include(x => x.Item)
            .ToListAsync();
    }

    private string GetInventoryStatus(decimal onHand, decimal safetyStock)
    {
        if (onHand <= 0) return "No Stock";
        if (onHand < safetyStock) return "Critical";
        if (onHand < safetyStock * 1.5m) return "Low";
        return "OK";
    }

    public void Dispose() => AppState.OnChange -= StateHasChanged;
}
