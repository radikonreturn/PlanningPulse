@page "/production"
@layout MainLayout
@inject AppState AppState
@implements IDisposable

<div class="card fade-up">
    <div class="card-header">
        <div class="card-title">Production Orders</div>
        <span class="badge badge-info">47 open</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Order #</th><th>Item</th><th>Qty</th><th>Due Date</th><th>Scheduled Start</th><th>Status</th></tr>
            </thead>
            <tbody>
                <tr><td>PO-0047</td><td>WIDGET-A001</td><td>200</td><td>Jul 22</td><td>Jul 15</td><td><span class="badge badge-info">Scheduled</span></td></tr>
                <tr><td>PO-0046</td><td>FRAME-B200</td><td>50</td><td>Jul 20</td><td>Jul 14</td><td><span class="badge badge-success">In Progress</span></td></tr>
                <tr><td>PO-0045</td><td>MOTOR-D010</td><td>15</td><td>Jul 28</td><td>Jul 18</td><td><span class="badge badge-warn">Pending</span></td></tr>
                <tr><td>PO-0044</td><td>BOLT-C050</td><td>1,000</td><td>Jul 25</td><td>Jul 20</td><td><span class="badge badge-warn">Pending</span></td></tr>
                <tr><td>PO-0043</td><td>ASSEMBLY-E001</td><td>10</td><td>Aug 1</td><td>Jul 22</td><td><span class="badge badge-danger">Delayed</span></td></tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        AppState.PageTitle = "Production Orders";
        AppState.OnChange += StateHasChanged;
    }
    public void Dispose() => AppState.OnChange -= StateHasChanged;
}
