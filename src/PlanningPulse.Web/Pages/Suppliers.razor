@page "/suppliers"
@layout MainLayout
@using Microsoft.EntityFrameworkCore
@using PlanningPulse.Domain.Suppliers
@inject AppState AppState
@inject PlanningPulse.Infrastructure.Persistence.PlanningPulseDbContext DbContext
@inject PlanningPulse.Application.Tenancy.ITenantSetter TenantSetter
@implements IDisposable

<div class="card fade-up">
    <div class="card-header">
        <div class="card-title">Suppliers Directory</div>
        <span class="badge badge-info">@suppliers.Count active partners</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Supplier Number</th>
                    <th>Supplier Name</th>
                    <th>Email Address</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (suppliers.Count == 0)
                {
                    <tr>
                        <td colspan="4" style="text-align:center;color:var(--text3);padding:20px;">No suppliers found.</td>
                    </tr>
                }
                @foreach (var sup in suppliers)
                {
                    <tr>
                        <td><strong>@sup.SupplierNumber</strong></td>
                        <td><strong>@sup.Name</strong></td>
                        <td><a href="mailto:@sup.Email" style="color:var(--indigo); text-decoration:none;">@sup.Email</a></td>
                        <td>
                            <span class="badge @(sup.IsActive ? "badge-success" : "badge-danger")">
                                @(sup.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Supplier> suppliers = new();

    protected override async Task OnInitializedAsync()
    {
        AppState.PageTitle = "Suppliers";
        AppState.OnChange += StateHasChanged;

        TenantSetter.SetTenant(AppState.TenantId);
        suppliers = await DbContext.Suppliers.ToListAsync();
    }

    public void Dispose() => AppState.OnChange -= StateHasChanged;
}
